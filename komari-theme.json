{
  "name": "Komari Zen",
  "short": "Zen",
  "description": "基于极简主义设计理念的 Komari 主题。",
  "version": "1.1.0",
  "author": "qwer-xyz",
  "url": "https://github.com/qwer-xyz/komari-theme-zen",
  "preview": "preview.png",
  "configuration": {
    "type": "managed",
    "name": {
      "en": "Zen Theme Settings",
      "zh-CN": "Zen 主题设置"
    },
    "data": [
      {
        "name": {
          "en": "General",
          "zh-CN": "通用"
        },
        "type": "title"
      },
      {
        "key": "showLogo",
        "type": "switch",
        "name": {
          "en": "Show logo",
          "zh-CN": "显示 Logo"
        },
        "default": false,
        "help": {
          "en": "Show logo beside title.",
          "zh-CN": "在标题旁显示 Logo。"
        }
      },
      {
        "key": "customLogoUrl",
        "type": "string",
        "name": {
          "en": "Custom logo URL",
          "zh-CN": "Logo 图片地址"
        },
        "default": "",
        "help": {
          "en": "Empty uses /favicon.ico.",
          "zh-CN": "留空使用 /favicon.ico。"
        }
      },
      {
        "key": "offlineServerPosition",
        "type": "select",
        "name": {
          "en": "Offline Server Position",
          "zh-CN": "离线节点位置"
        },
        "options": "首位,保持,末尾",
        "default": "末尾",
        "help": {
          "en": "Offline node priority applies to the default and metric sorts. Keep follows the selected sort.",
          "zh-CN": "适用于默认顺序及指标排序；选择“保持”时跟随当前排序。"
        }
      },
      {
        "key": "showOfflineGroup",
        "type": "switch",
        "name": {
          "en": "Show offline group",
          "zh-CN": "显示离线分组"
        },
        "default": false,
        "help": {
          "en": "Show an Offline filter when offline nodes exist.",
          "zh-CN": "存在离线节点时，在首页分组中显示“离线”筛选。"
        }
      },
      {
        "key": "showExpiryTime",
        "type": "switch",
        "name": {
          "en": "Show expiry and pricing",
          "zh-CN": "显示到期与价格"
        },
        "default": true,
        "help": {
          "en": "Show expiry and pricing on the dashboard and node details.",
          "zh-CN": "同时控制首页与节点详情中的到期时间、价格信息。"
        }
      },
      {
        "key": "showResidualValue",
        "type": "switch",
        "name": {
          "en": "Show residual value",
          "zh-CN": "显示剩余价值"
        },
        "default": false,
        "help": {
          "en": "Calculate remaining node value.",
          "zh-CN": "统计节点剩余价值。"
        }
      },
      {
        "key": "residualValueCurrency",
        "type": "string",
        "name": {
          "en": "Residual value currency",
          "zh-CN": "剩余价值主货币"
        },
        "default": "CNY",
        "help": {
          "en": "Enter an ISO 4217 three-letter currency code, such as CNY, USD, or EUR.",
          "zh-CN": "输入 ISO 4217 三字母货币代码，例如 CNY、USD、EUR。"
        }
      },
      {
        "key": "defaultViewMode",
        "type": "select",
        "name": {
          "en": "Default view mode",
          "zh-CN": "默认视图模式"
        },
        "options": "卡片,列表",
        "default": "卡片",
        "help": {
          "en": "Initial layout. Visitor choices take priority; narrow screens use cards until changed.",
          "zh-CN": "首次访问的布局；访客手动选择优先，窄屏默认使用卡片。"
        }
      },
      {
        "key": "defaultSortField",
        "type": "select",
        "name": {
          "en": "Default sort field",
          "zh-CN": "默认排序指标"
        },
        "options": "默认,名称,处理器,内存,硬盘,带宽,流量,延迟,到期,状态,系统",
        "default": "默认",
        "help": {
          "en": "Initial sorting metric. A sort selected in the page URL takes priority.",
          "zh-CN": "首次访问的排序指标；页面选择的排序优先。"
        }
      },
      {
        "key": "showNodeMap",
        "type": "switch",
        "name": {
          "en": "Show node distribution map",
          "zh-CN": "显示节点分布地图"
        },
        "default": true,
        "help": {
          "en": "Show the dashboard map.",
          "zh-CN": "显示首页地图。"
        }
      },
      {
        "name": {
          "en": "Latency",
          "zh-CN": "延迟检测"
        },
        "type": "title"
      },
      {
        "key": "showLatency",
        "type": "switch",
        "name": {
          "en": "Show latency on cards",
          "zh-CN": "显示延迟信息"
        },
        "default": true,
        "help": {
          "en": "Show latency on the dashboard and node details.",
          "zh-CN": "同时控制首页延迟信息与节点详情的延迟检测。"
        }
      },
      {
        "key": "pingTaskIds",
        "type": "pingtasks",
        "name": {
          "en": "Displayed Ping tasks",
          "zh-CN": "显示的 Ping 任务"
        },
        "default": "[]",
        "help": {
          "en": "Choose Ping tasks used by cards and node details. Empty includes all tasks.",
          "zh-CN": "选择卡片和节点详情使用的 Ping 任务，留空表示全部任务。"
        }
      },
      {
        "key": "latencyColorMode",
        "type": "select",
        "name": {
          "en": "Latency color mode",
          "zh-CN": "延迟色块分级模式"
        },
        "options": "固定,均值偏移",
        "default": "均值偏移",
        "help": {
          "en": "Built-in thresholds: Fixed 100/150 ms; MeanDelta +10/+30 ms.",
          "zh-CN": "使用内置分级：固定模式 100/150 ms，均值偏移模式 +10/+30 ms。"
        }
      },
      {
        "name": {
          "en": "Appearance",
          "zh-CN": "外观"
        },
        "type": "title"
      },
      {
        "key": "colorPreset",
        "type": "select",
        "name": {
          "en": "Color preset",
          "zh-CN": "配色方案"
        },
        "options": "中性白,柔暖色,科技蓝,薄荷绿",
        "default": "中性白",
        "help": {
          "en": "Neutral White (Kumo), Soft Warm (Anthropic), Tech Blue (IBM Carbon), and Mint Green (Supabase). All four include light and dark modes.",
          "zh-CN": "中性白（Kumo）、柔暖色（Anthropic）、科技蓝（IBM Carbon）、薄荷绿（Supabase），均包含亮暗模式。"
        }
      },
      {
        "key": "customAccentLight",
        "type": "string",
        "name": {
          "en": "Custom accent color (light)",
          "zh-CN": "自定义强调色（亮色）"
        },
        "default": "",
        "help": {
          "en": "Optional #RGB, #RRGGBB or #RRGGBBAA. Applies to light-mode interactions across all pages; leave blank for the preset.",
          "zh-CN": "可填 #RGB、#RRGGBB 或 #RRGGBBAA；统一亮色模式交互强调色，留空沿用配色方案。"
        }
      },
      {
        "key": "customAccentDark",
        "type": "string",
        "name": {
          "en": "Custom accent color (dark)",
          "zh-CN": "自定义强调色（暗色）"
        },
        "default": "",
        "help": {
          "en": "Optional #RGB, #RRGGBB or #RRGGBBAA. Applies to dark-mode interactions across all pages; leave blank for the preset.",
          "zh-CN": "可填 #RGB、#RRGGBB 或 #RRGGBBAA；统一暗色模式交互强调色，留空沿用配色方案。"
        }
      },
      {
        "key": "fontPreset",
        "type": "select",
        "name": {
          "en": "Font preset",
          "zh-CN": "字体方案"
        },
        "options": "默认,系统字体,等宽,游梦,霞鹜文楷,文源圆体",
        "default": "默认",
        "help": {
          "en": "Site-wide font.",
          "zh-CN": "全站字体。"
        }
      },
      {
        "name": {
          "en": "Footer",
          "zh-CN": "页脚"
        },
        "type": "title"
      },
      {
        "key": "customFooterHtml",
        "type": "string",
        "name": {
          "en": "Custom footer content",
          "zh-CN": "自定义页脚内容"
        },
        "default": "",
        "help": {
          "en": "Footer HTML or text.",
          "zh-CN": "页脚 HTML 或文本。"
        }
      }
    ]
  }
}
